      "id": "f7172275-4e22-4b20-b289-cea72a01c9a3",
      "name": "Merge Request Context + Response",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        80,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * Menghitung Non-Tree Area (ha) dari respons API dan menyimpan hasil per kuartal\n * ke staticData.results (dipakai setelah loop selesai).\n *\n * Ekspektasi minimum respons (boleh salah satu):\n * - body.treeAreaHa / body.totalAreaHa\n * - body.tree_area_ha / body.total_area_ha\n * - body.nonTreeAreaHa (+ optional tree/total)\n */\nconst input = $json;\n\n// Jika HTTP Request memakai fullResponse=true, respons ada di input.body\nconst body = input.body ?? input;\n\nconst tree =\n  Number(body.treeAreaHa ?? body.tree_area_ha ?? body.tree_ha ?? body.treeHa ?? 0);\n\nlet total = body.totalAreaHa ?? body.total_area_ha ?? body.total_ha ?? body.totalHa;\ntotal = total === undefined || total === null ? null : Number(total);\n\nlet nonTree = body.nonTreeAreaHa ?? body.non_tree_area_ha ?? body.non_tree_ha ?? body.nonTreeHa;\nnonTree = nonTree === undefined || nonTree === null ? null : Number(nonTree);\n\nif (nonTree === null && total !== null) nonTree = total - tree;\nif (total === null && nonTree !== null) total = nonTree + tree;\n\nconst nonTreePct = (total && total > 0 && nonTree !== null) ? (nonTree / total) * 100 : null;\n\nconst row = {\n  periodLabel: input.periodLabel,\n  startDate: input.startDate,\n  endDate: input.endDate,\n  treeAreaHa: tree,\n  nonTreeAreaHa: nonTree,\n  totalAreaHa: total,\n  nonTreePct,\n  apiStatusCode: input.statusCode ?? null,\n};\n\nconst staticData = this.getWorkflowStaticData('global');\nstaticData.results = staticData.results || [];\nstaticData.results.push(row);\n\nreturn [{ json: row }];\n"
      },
