    {
      "parameters": {
        "jsCode": "/**\n * Output: 20 kuartal terakhir (5 tahun) sampai kuartal terakhir yang sudah selesai.\n * Setiap item membawa konfigurasi (AOI, threshold, dll) + startDate/endDate/periodLabel.\n * Sekaligus reset penampung hasil (staticData.results) untuk eksekusi ini.\n */\nconst cfg = $input.first().json;\n\nconst staticData = this.getWorkflowStaticData('global');\nstaticData.results = [];\nstaticData.generatedAt = new Date().toISOString();\n\nconst now = new Date();\nconst currentQ = Math.floor(now.getUTCMonth() / 3) + 1; // 1..4\nlet endQ = currentQ - 1;\nlet endYear = now.getUTCFullYear();\nif (endQ === 0) {\n  endQ = 4;\n  endYear -= 1;\n}\n\nfunction quarterStartUTC(year, q) {\n  const m = (q - 1) * 3; // 0,3,6,9\n  return new Date(Date.UTC(year, m, 1, 0, 0, 0, 0));\n}\n\nconst periods = [];\nfor (let i = 19; i >= 0; i--) {\n  let q = endQ - i;\n  let y = endYear;\n  while (q <= 0) { q += 4; y -= 1; }\n\n  const start = quarterStartUTC(y, q);\n  const nextQ = q === 4 ? 1 : q + 1;\n  const nextY = q === 4 ? y + 1 : y;\n  const endExclusive = quarterStartUTC(nextY, nextQ);\n  const endInclusive = new Date(endExclusive);\n  endInclusive.setUTCDate(endInclusive.getUTCDate() - 1);\n\n  const startDate = start.toISOString().slice(0, 10);\n  const endDate = endInclusive.toISOString().slice(0, 10);\n\n  periods.push({\n    ...cfg,\n    periodLabel: `${y}-Q${q}`,\n    startDate,\n    endDate,\n  });\n}\n\nreturn periods.map(p => ({ json: p }));\n"
      },
