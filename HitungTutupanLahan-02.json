    {
      "parameters": {
        "jsCode": "/**\n * Membentuk payload 1 baris untuk Google Sheets:\n * - generatedAt: ISO string\n * - reportMarkdown: output dari agent\n * - resultsJson: JSON ringkas hasil kuartalan\n */\nconst generatedAt = new Date().toISOString();\n\n// Output agent biasanya ada di $json.output\nconst reportMarkdown = $json.output ?? $json.text ?? '';\n\nconst periods = Array.isArray($json.periodLabel) ? $json.periodLabel.length : 0;\nconst rows = [];\nfor (let i = 0; i < periods; i++) {\n  rows.push({\n    periodLabel: $json.periodLabel[i],\n    startDate: $json.startDate?.[i],\n    endDate: $json.endDate?.[i],\n    treeAreaHa: $json.treeAreaHa?.[i],\n    nonTreeAreaHa: $json.nonTreeAreaHa?.[i],\n    totalAreaHa: $json.totalAreaHa?.[i],\n    nonTreePct: $json.nonTreePct?.[i],\n  });\n}\n\nreturn [{\n  json: {\n    generatedAt,\n    reportMarkdown,\n    resultsJson: JSON.stringify(rows),\n  }\n}];\n"
      },
